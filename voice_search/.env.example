DATA_DIR=./data
CHROMA_COLLECTION=voice_search

# Embeddings (downloaded once by scripts/download_models.py, then offline).
# For Hindi or mixed-language speech use a multilingual model, e.g. intfloat/multilingual-e5-small
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OFFLINE_MODE=true

# Speech-to-text. Models: tiny | base | small | medium | large-v3 (bigger = more accurate, slower)
WHISPER_MODEL=small
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=int8    # int8 for CPU; float16 for a CUDA GPU
WHISPER_LANGUAGE=            # empty = auto-detect; or en, hi, ...
WHISPER_TASK=transcribe      # "translate" turns any language into English text

# Grouping transcript into searchable chunks
CHUNK_SECONDS=30
CHUNK_MAX_CHARS=700
TOP_K=5
